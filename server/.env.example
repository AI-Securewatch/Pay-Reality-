# development | production. production enables strict boot-time config
# validation (see app/main.py::_validate_production_config) and HSTS.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://payreality@localhost:5432/payreality_dev

OPA_URL=http://127.0.0.1:8181
OPA_BINARY_PATH=opa

# ED25519 signing key for Evidence records, base64-encoded 32-byte seed.
# Generate for local dev with: python -c "import nacl.signing,base64; print(base64.b64encode(bytes(nacl.signing.SigningKey.generate())).decode())"
EVIDENCE_SIGNING_KEY_B64=
EVIDENCE_SIGNING_KEY_ID=signing_key_dev

# Shared operator credential gating policy review/compile/activate and
# decision-resolution endpoints (see app/security.py). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

ANTHROPIC_API_KEY=

# Window, in seconds, within which a signed Intent's requested_at must fall.
INTENT_SIGNATURE_WINDOW_SECONDS=300

CORS_ORIGIN=http://localhost:5173
