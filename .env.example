VITE_API_URL=/api

# Mixpanel project token -- the same project the marketing website
# (aisecurewatch.com) reports to, so both apps' events land in one place.
# Analytics silently disables itself if this is unset. See
# src/app/services/analytics.ts.
VITE_MIXPANEL_TOKEN=

# Set to "true" to enable analytics on localhost for testing. Skipped on
# localhost by default even when VITE_MIXPANEL_TOKEN is set.
VITE_MIXPANEL_DEBUG=
